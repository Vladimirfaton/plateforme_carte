
# ====== JWT ======
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# ====== STORAGE ======
STORAGE_TYPE=local
# local: stockage fichiers serveur (./uploads)
# supabase: stockage cloud Supabase
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# ====== LOGGING ======
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ====== CORS ======
CORS_ORIGIN=http://localhost:3000

# ====== ADMIN LOGIN (INITIAL) ======
ADMIN_EMAIL=admin@fvs.com
ADMIN_PASSWORD=ChangeMe123!

# ====== FVS INFO ======
FVS_COMPANY_NAME=FVS
FVS_CONTACT_EMAIL=contact@fvs.com
FVS_PHONE=+229 97 268 741
FVS_WEBSITE=fvs.com

# ====== CARD SETTINGS ======
CARD_WIDTH=85.6
CARD_HEIGHT=54
CARD_DPI=300
UPDATE access_keys
SET status = 'active', expires_at = NOW() + INTERVAL '5 minutes'
WHERE id = (
  SELECT id FROM access_keys
  WHERE college_id = '47c07e7b-24ea-4868-a372-ea1c9c784b1b'
  ORDER BY issued_at DESC
  LIMIT 1
);

UPDATE users
SET status = 'active'
WHERE college_id = '47c07e7b-24ea-4868-a372-ea1c9c784b1b'
  AND role IN ('directeur', 'secretaire');

  SELECT id, college_id, status, expires_at FROM access_keys
WHERE college_id = '47c07e7b-24ea-4868-a372-ea1c9c784b1b'
ORDER BY issued_at DESC
LIMIT 1;