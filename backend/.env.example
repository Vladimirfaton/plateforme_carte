# ====== SERVER ======
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# ====== SUPABASE ======
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ====== DATABASE (PostgreSQL) ======
DATABASE_URL=postgresql://user:password@localhost:5432/fvs_cartes

# ====== JWT ======
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# ====== STORAGE ======
STORAGE_TYPE=local
# local: stockage fichiers serveur (./uploads)
# supabase: stockage cloud Supabase
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# ====== LOGGING ======
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ====== CORS ======
CORS_ORIGIN=http://localhost:3000

# ====== ADMIN LOGIN (INITIAL) ======
ADMIN_EMAIL=admin@fvs.com
ADMIN_PASSWORD=ChangeMe123!

# ====== FVS INFO ======
FVS_COMPANY_NAME=FVS
FVS_CONTACT_EMAIL=contact@fvs.com
FVS_PHONE=+229 97 268 741
FVS_WEBSITE=fvs.com

# ====== CARD SETTINGS ======
CARD_WIDTH=85.6
CARD_HEIGHT=54
CARD_DPI=300
